{
  "schema_version": 1,
  "title": "세계 수요 전망 하향에 따른 연간 EBITDA 민감도",
  "description": "2026년 수요 증가율 전망 하향 1.0%포인트를 가상 노출물량에 적용한 예비 민감도입니다.",
  "as_of": "2026-08-19",
  "confidence": "low",
  "notice": "공개 전망과 AI 가정을 결합한 민감도이며 POSCO 실제 판매량·가격·마진이 아닙니다.",
  "formula_display": "노출물량 × 가격 × 수요전망 하향폭 × 물량민감도 × 공헌이익률",
  "variables": [
    {
      "id": "exposed_volume",
      "label": "영향권 판매물량",
      "unit": "kt/년",
      "min": 100,
      "max": 5000,
      "step": 100,
      "default": 1000,
      "kind": "assumption",
      "basis": "내부 제품·지역별 판매물량으로 교체할 가정",
      "source_ids": []
    },
    {
      "id": "price",
      "label": "평균 판매가격",
      "unit": "USD/t",
      "min": 400,
      "max": 1500,
      "step": 50,
      "default": 700,
      "kind": "assumption",
      "basis": "제품구성 미확인 상태의 민감도 가정",
      "source_ids": []
    },
    {
      "id": "forecast_revision",
      "label": "수요 증가율 하향폭",
      "unit": "%p",
      "min": 0.1,
      "max": 3,
      "step": 0.1,
      "default": 1,
      "kind": "verified",
      "basis": "worldsteel 2025년 10월 1.3%에서 2026년 4월 0.3%로 조정",
      "source_ids": ["SRC-20260819-33A52DFC", "SRC-20260819-4E44C10E"]
    },
    {
      "id": "volume_sensitivity",
      "label": "POSCO 물량 민감도",
      "unit": "fraction",
      "min": 0.1,
      "max": 1,
      "step": 0.05,
      "default": 0.5,
      "kind": "assumption",
      "basis": "세계 수요 변화가 영향권 판매량에 전달되는 비율",
      "source_ids": []
    },
    {
      "id": "contribution_margin",
      "label": "공헌이익률",
      "unit": "fraction",
      "min": 0.03,
      "max": 0.3,
      "step": 0.01,
      "default": 0.15,
      "kind": "assumption",
      "basis": "내부 제품별 공헌이익률로 교체할 가정",
      "source_ids": []
    }
  ],
  "outputs": [
    {
      "id": "annual_ebitda_at_risk",
      "label": "연간 EBITDA 하방 민감도",
      "unit": "USD m/년",
      "decimals": 1,
      "primary": true,
      "expression": {
        "op": "divide",
        "args": [
          {
            "op": "multiply",
            "args": [
              {"var": "exposed_volume"},
              {"var": "price"},
              {"op": "divide", "args": [{"var": "forecast_revision"}, 100]},
              {"var": "volume_sensitivity"},
              {"var": "contribution_margin"}
            ]
          },
          1000
        ]
      }
    }
  ],
  "presets": [
    {"id": "defense", "label": "방어", "values": {"exposed_volume": 500, "price": 900, "forecast_revision": 0.5, "volume_sensitivity": 0.25, "contribution_margin": 0.2}},
    {"id": "base", "label": "기준", "values": {"exposed_volume": 1000, "price": 700, "forecast_revision": 1, "volume_sensitivity": 0.5, "contribution_margin": 0.15}},
    {"id": "pressure", "label": "압박", "values": {"exposed_volume": 2500, "price": 600, "forecast_revision": 2, "volume_sensitivity": 0.8, "contribution_margin": 0.1}}
  ]
}
